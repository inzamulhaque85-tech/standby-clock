<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true"
    android:padding="8dp"> <!-- ঘড়ি বড় করার জন্য প্যারেন্ট প্যাডিং কমানো হয়েছে -->

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- ১/ বড় ডিজিটাল ক্লক (সাইজ ২০০sp করা হয়েছে) -->
        <TextClock
            android:id="@+id/textClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:fontFamily="@font/sf_pro_rounded_bold"
            android:includeFontPadding="false"
            android:textColor="#2196F3"
            android:textSize="200sp" /> <!-- প্রয়োজন অনুযায়ী এটি বাড়িয়ে ২২০০sp বা ২৫০sp করতে পারেন -->

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <!-- ২/ তারিখ (SF Compact Font এবং সাইজ ১৮sp) -->
            <TextView
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sf_compact"
                android:textColor="#2196F3"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- ৩/ তাপমাত্রা (তারিখ থেকে ৮dp/১ সেমি ফাঁকা এবং সাইজ ১৬sp) -->
            <TextView
                android:id="@+id/tvTemp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" 
                android:fontFamily="@font/sf_compact"
                android:textColor="#2196F3"
                android:textSize="16sp"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
